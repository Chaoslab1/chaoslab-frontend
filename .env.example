# =============================================================================
# Algolia DocSearch – Environment Variables
# =============================================================================
# Full-text search is powered by Algolia DocSearch (free for open‑source
# projects).  Before search will work in the docs portal you need to:
#
#   1. Apply at https://docsearch.algolia.com/apply
#      (your site is https://chaoslab1.github.io/chaoslab-frontend/)
#
#   2. Once approved, copy this file to .env and fill in the three values
#      you received from Algolia.
#
#   3. The search bar will automatically appear in the navbar.
#
# Security note: the API key below is a *search‑only* key that is safe to
# commit into client code.  Never expose an admin or write API key.
# =============================================================================
ALGOLIA_APP_ID=
ALGOLIA_API_KEY=
ALGOLIA_INDEX_NAME=

# =============================================================================
# OpenAPI Spec Sync – Environment Variables
# =============================================================================
# The API Reference (Redoc) and Sandbox (Swagger UI) pages fetch a live
# openapi.yaml/json spec that `npm run sync:openapi` downloads from a running
# chaoslab-backend before every `start`/`build`.
#
# Point this at a reachable chaoslab-backend deployment — e.g. a local
# instance (default) or the staging/production API. It's read from
# <OPENAPI_SOURCE_URL>/docs/openapi.json.
#
# If unset or unreachable, the sync step logs a warning and skips itself
# instead of failing the build — those two pages will just 404 until it's
# configured.
# =============================================================================
OPENAPI_SOURCE_URL=http://localhost:3000
